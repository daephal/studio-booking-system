# 배포 도메인 (없으면 http://localhost:3000). Vercel 배포 후 *.vercel.app 주소로 설정하세요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Supabase 프로젝트 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 -----------------------------------------------------------
# Cloudflare 대시보드 > R2 > Manage R2 API Tokens 에서 발급
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- 이메일 발송 (둘 중 하나만 설정하면 됩니다) --------------------------------------
# 방법 A) Resend — 자체 도메인이 있을 때 권장 (더 안정적, 앱 비밀번호 불필요)
#   1. https://resend.com 가입 → API Keys에서 키 발급 → RESEND_API_KEY
#   2. Domains에서 보유 도메인 인증(DNS 레코드 추가) → 인증된 도메인의 주소를 EMAIL_FROM에 입력
#   ※ 도메인 인증 전에는 실제 고객에게 발송이 안 되므로, 도메인이 없다면 방법 B를 사용하세요.
RESEND_API_KEY=
EMAIL_FROM=

# 방법 B) Gmail SMTP — 도메인이 없어도 바로 사용 가능 (기본값)
# 알림을 받을 Gmail 계정의 앱 비밀번호 (2단계 인증 필요)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Google Calendar OAuth ---------------------------------------------------
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 OAuth 클라이언트 ID 생성
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 배포 도메인 기준 예: https://your-domain.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- 보안 -----------------------------------------------------------------
# 고객 갤러리 세션 쿠키 서명용 임의의 긴 무작위 문자열 (openssl rand -hex 32 등으로 생성)
GALLERY_SESSION_SECRET=

# Vercel Cron 요청 검증용 임의의 문자열. Vercel이 자동으로 Authorization 헤더에 실어 보냅니다.
CRON_SECRET=
